# Google Ads MCP configuration
# Keep every credential outside the repository.

# Authentication type: oauth or service_account
GOOGLE_ADS_AUTH_TYPE=oauth

# OAuth: immutable client configuration downloaded from Google Cloud.
#
# PICK ONE MODE, NOT BOTH. This file path wins over the inline GOOGLE_ADS_CLIENT_ID and
# GOOGLE_ADS_CLIENT_SECRET further down: as long as it is set, the server reads it and fails with
# a missing-file error before those inline values are ever considered. To use the inline pair,
# leave this variable EMPTY.
GOOGLE_ADS_OAUTH_CLIENT_PATH=/absolute/path/outside/repository/oauth-client.json

# OAuth: generated user token. This must be a different file from the client configuration.
GOOGLE_ADS_OAUTH_TOKEN_PATH=/absolute/path/outside/repository/google-ads-token.json

# Interactive OAuth is disabled during normal MCP execution. Set to 1 only for an explicit,
# supervised one-time setup, then restore 0.
GOOGLE_ADS_ALLOW_INTERACTIVE_OAUTH=0

# Service account alternative. Used only when GOOGLE_ADS_AUTH_TYPE=service_account.
GOOGLE_ADS_SERVICE_ACCOUNT_PATH=/absolute/path/outside/repository/service-account.json
GOOGLE_ADS_IMPERSONATION_EMAIL=

# Required Google Ads API developer token. Supply the real value through your process manager.
GOOGLE_ADS_DEVELOPER_TOKEN=replace_at_runtime

# Optional manager account ID, with or without dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional OAuth client values, used ONLY when GOOGLE_ADS_OAUTH_CLIENT_PATH above is empty.
GOOGLE_ADS_CLIENT_ID=replace_at_runtime
GOOGLE_ADS_CLIENT_SECRET=replace_at_runtime
